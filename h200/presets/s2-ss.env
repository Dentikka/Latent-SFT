# Stage 2 with parallel scheduled sampling (modeling_stage2._scheduled_sampling), continued from the
# merged epoch-40 model: the original encoder soft labels and Stage-2 recipe (Gumbel noise 1.0 on
# the labels), but each latent input is replaced with probability LSFT_SS_RHO by the model's own
# prediction from a no-grad teacher-forced pass; targets stay the encoder latents. Attacks the
# exposure bias: 0.956 with encoder latents vs ~0.40 with its own; self-distillation on own
# correct latents (s2-sd) did not move accuracy (KL to own noisy mixtures 0.66 -> 0.62).
export LSFT_SS_RHO=0.5
U="$LSFT_EXPS/1006-s1-union-lmhead"
LATENT_MODEL="$LSFT_MODELS/qwen-s2-ep40"
LABELS="$U/soft-labels"
LSFT_TRAIN="$LSFT_DATA/OpenR1-Math-220k-v-train-4k-honest-think.jsonl"
TOPK=10
LR=1e-4
EPOCHS=2
GLOBAL_BATCH=256
PER_DEVICE_BS=2
GUMBEL_T=1.0
NOISE_SCALE=1.0
SAVE_STRATEGY=steps
SAVE_STEPS=75
SAVE_TOTAL_LIMIT=1
KEEP_HF_EVERY=1
