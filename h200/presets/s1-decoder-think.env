# Stage-1 decoder, honest think-only data: latent chain = the <think> body (the same latent
# content as the authors' model), text = \boxed{X} only (make_honest_data.py --latent think).
# Encoder: 1002-s1-encoder-honest epoch 2, trained on think+prose. It is reused as is: the
# encoder is causal (a latent sees only the text before it) and the think-only chain is an
# exact prefix of the think+prose chain, so its latents and per-segment targets on the think
# part are identical; only the ~10-token answer term after </think> differs.
LSFT_TRAIN="$LSFT_DATA/OpenR1-Math-220k-v-train-4k-honest-think.jsonl"
ENCODER="$LSFT_EXPS/1002-s1-encoder-honest/epochs/epoch-2-step-1797/hf"
DECODER="$LSFT_BASE"
TOPK=10
COMPRESSION=2
LR=5e-5
EPOCHS=2
GLOBAL_BATCH=64
PER_DEVICE_BS=1
SAVE_STRATEGY=steps
SAVE_STEPS=100
SAVE_TOTAL_LIMIT=2
