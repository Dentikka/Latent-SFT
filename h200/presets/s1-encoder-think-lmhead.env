# Stage-1 encoder, honest think-only data, latent top-K selected by the decoder's output head
# (LSFT_LATENT_READOUT=lm_head) instead of h @ E_in. Qwen2.5-Math-7B has untied embeddings:
# with the repo readout the untrained encoder's latents carry nothing (next-chunk token in
# top-10: 0.1%), with lm_head 70%; the 1002 encoder trained 2 epochs with the repo readout
# reached only 6% and put '9' on top in 54% of latents. Otherwise as 1002: r=2, lr 5e-5, 2 epochs.
export LSFT_LATENT_READOUT=lm_head
LSFT_TRAIN="$LSFT_DATA/OpenR1-Math-220k-v-train-4k-honest-think.jsonl"
ENCODER="$LSFT_BASE"
DECODER="$LSFT_BASE"
TOPK=10
COMPRESSION=2
LR=5e-5
EPOCHS=2
GLOBAL_BATCH=64
PER_DEVICE_BS=1
SAVE_STRATEGY=steps
SAVE_STEPS=100
SAVE_TOTAL_LIMIT=2
