# Stage-1 decoder on the lm_head-readout encoder (1004-s1-encoder-lmhead, epoch 2), honest
# think-only data. The readout flag must match the encoder's: the decoder is trained on
# latents mixed from the top-K picked by the decoder's output head.
export LSFT_LATENT_READOUT=lm_head
LSFT_TRAIN="$LSFT_DATA/OpenR1-Math-220k-v-train-4k-honest-think.jsonl"
ENCODER="$(ls -d "$LSFT_EXPS"/1004-s1-encoder-lmhead/epochs/epoch-2-step-*/hf 2>/dev/null | head -1)"
DECODER="$LSFT_BASE"
TOPK=10
COMPRESSION=2
LR=5e-5
EPOCHS=2
GLOBAL_BATCH=64
PER_DEVICE_BS=1
SAVE_STRATEGY=steps
SAVE_STEPS=100
SAVE_TOTAL_LIMIT=2
# No activation checkpointing: the encoder is frozen here (its forward stores nothing) and the
# decoder took ~42 GB with it, so the ~25% recompute is pure waste on a 141 GB card.
GRAD_CKPT=False
