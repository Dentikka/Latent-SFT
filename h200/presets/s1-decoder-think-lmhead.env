# Stage-1 decoder on the lm_head-readout encoder (1004-s1-encoder-lmhead, its latest kept
# epoch), honest think-only data. The readout flag must match the encoder's: the decoder is
# trained on latents mixed from the top-K picked by the decoder's output head.
export LSFT_LATENT_READOUT=lm_head
LSFT_TRAIN="$LSFT_DATA/OpenR1-Math-220k-v-train-4k-honest-think.jsonl"
ENCODER="$(ls -d "$LSFT_EXPS"/1004-s1-encoder-lmhead/epochs/epoch-*/hf 2>/dev/null | sort -V | tail -1)"
DECODER="$LSFT_BASE"
TOPK=10
COMPRESSION=2
LR=5e-5
EPOCHS=1   # 1002: the 2nd epoch gave 6.06 -> 5.93; override with EPOCHS=2 on submit
GLOBAL_BATCH=64
PER_DEVICE_BS=1
SAVE_STRATEGY=steps
SAVE_STEPS=100
SAVE_TOTAL_LIMIT=2
# No activation checkpointing: the encoder is frozen here (its forward stores nothing) and the
# decoder took ~42 GB with it, so the ~25% recompute is pure waste on a 141 GB card.
GRAD_CKPT=False
# Then the union step, without waiting for anyone to resubmit.
NEXT="union s1-union-think-lmhead 1006-s1-union-lmhead"
