# Stage-1 encoder on the honest-latent data: think + prose -> latent chain, text = \boxed{X}
# (h200/make_honest_data.py). Hyperparameters of Latent-GRPO Appendix B (compression 2,
# lr 5e-5); budget 2 epochs instead of 10 (~15 h per epoch on 2 x H200).
# Saves every 100 steps (~1.7 h) for the 8 h job chain; end-of-epoch weights are kept
# in <exp>/epochs/ by h200/keep_epochs.py.
LSFT_TRAIN="$LSFT_DATA/OpenR1-Math-220k-v-train-4k-honest.jsonl"
ENCODER="$LSFT_BASE"
DECODER="$LSFT_BASE"
TOPK=10
COMPRESSION=2
LR=5e-5
EPOCHS=2
GLOBAL_BATCH=64
PER_DEVICE_BS=1
SAVE_STRATEGY=steps
SAVE_STEPS=100
SAVE_TOTAL_LIMIT=2
