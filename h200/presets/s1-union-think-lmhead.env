# Stage-1 union (encoder + decoder trained jointly) on the lm_head-readout pair: encoder
# 1004-s1-encoder-lmhead and decoder 1005-s1-decoder-lmhead, latest kept epochs. Honest
# think-only data; 1 epoch (Appendix B: lr 5e-5 for every stage-1 step). Activation
# checkpointing stays on: both modules train here, and the encoder step alone took 74-84 GB.
export LSFT_LATENT_READOUT=lm_head
LSFT_TRAIN="$LSFT_DATA/OpenR1-Math-220k-v-train-4k-honest-think.jsonl"
ENCODER="$(ls -d "$LSFT_EXPS"/1004-s1-encoder-lmhead/epochs/epoch-*/hf 2>/dev/null | sort -V | tail -1)"
DECODER="$(ls -d "$LSFT_EXPS"/1005-s1-decoder-lmhead/epochs/epoch-*/hf 2>/dev/null | sort -V | tail -1)"
TOPK=10
COMPRESSION=2
LR=5e-5
EPOCHS=1
GLOBAL_BATCH=64
PER_DEVICE_BS=1
SAVE_STRATEGY=steps
SAVE_STEPS=100
SAVE_TOTAL_LIMIT=2
