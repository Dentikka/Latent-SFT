# Self-distillation on own latents (latent-space RFT): Stage 2 continued from the merged epoch-40
# model on its own correct noisy rollouts (Latent-GRPO h200/sd_gen.sbatch -> sd_pack.py). The fed
# top-K mixtures are both the latent inputs and the KL targets, so no extra Gumbel noise
# (NOISE_SCALE=0 makes apply_gumbel_noise the identity); CE on '</think>' + generated \boxed{X}.
# Base: h200/make_sd_base.sh (merged epoch 40 + the Stage-2 tokenizer; the path must contain "qwen").
# Pass the data as overrides: LABELS=<pack>/soft-labels LSFT_TRAIN=<pack>/sd-train.jsonl
LATENT_MODEL="$LSFT_MODELS/qwen-s2-ep40"
TOPK=10
LR=1e-4
EPOCHS=3
GLOBAL_BATCH=64
PER_DEVICE_BS=1   # own rollouts reach 4064 latents (Stage-2 data ~2k; bs 4 OOMed there)
GUMBEL_T=1.0
NOISE_SCALE=0
SAVE_STRATEGY=steps
SAVE_STEPS=100
SAVE_TOTAL_LIMIT=1
KEEP_HF_EVERY=1   # merged hf/ per epoch for the sglang eval (~15 GB each)
