# Stage 2 on the lm_head-readout Stage-1 pair (union 1006-s1-union-lmhead): its merged decoder
# as the initial model and its encoder's soft labels, honest think-only data (answer = \boxed{X}).
# Recipe of Latent-GRPO Appendix B / their gsm8k script: lr 3e-4, 70 epochs, Gumbel noise 1.0 at
# temperature 1.0, LoRA r64; global batch 256 as in their scripts (4 x 8 x 8 GPUs -> 2 x 64 x 2).
U="$LSFT_EXPS/1006-s1-union-lmhead"
LATENT_MODEL="$U/stage2-init"
LABELS="$U/soft-labels"
LSFT_TRAIN="$LSFT_DATA/OpenR1-Math-220k-v-train-4k-honest-think.jsonl"
TOPK=10
LR=3e-4
EPOCHS=70
GLOBAL_BATCH=256
PER_DEVICE_BS=2   # 4 OOMed at step 105 on 140 GB (latent chains up to ~2k); global batch stays 256
GUMBEL_T=1.0
NOISE_SCALE=1.0
SAVE_STRATEGY=steps
SAVE_STEPS=75   # ~1/3 epoch (225 steps): a cut 8-h job loses <40 min; epoch ends are saved anyway
SAVE_TOTAL_LIMIT=2
KEEP_HF_EVERY=5
