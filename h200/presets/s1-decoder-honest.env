# Stage-1 decoder on the honest-latent data: the encoder from 1002-s1-encoder-honest
# (epoch 2, lower CE than epoch 1; the Math-500 encoder eval cannot tell them apart because
# the frozen base decoder does not answer from latents yet) is frozen, LoRA on the decoder.
# Same hyperparameters and budget as the encoder step: compression 2, lr 5e-5, 2 epochs.
LSFT_TRAIN="$LSFT_DATA/OpenR1-Math-220k-v-train-4k-honest.jsonl"
ENCODER="$LSFT_EXPS/1002-s1-encoder-honest/epochs/epoch-2-step-1797/hf"
DECODER="$LSFT_BASE"
TOPK=10
COMPRESSION=2
LR=5e-5
EPOCHS=2
GLOBAL_BATCH=64
PER_DEVICE_BS=1
SAVE_STRATEGY=steps
SAVE_STEPS=100
SAVE_TOTAL_LIMIT=2
