# 20 optimizer steps of the Stage-1 encoder at compression 2 (the costliest setting):
# measures seconds per step and GPU memory on 2 x H200. No checkpoints, no W&B.
ENCODER="$LSFT_BASE"
DECODER="$LSFT_BASE"
TOPK=10
COMPRESSION=2
LR=1e-5
EPOCHS=1
MAX_STEPS=20
GLOBAL_BATCH=64
PER_DEVICE_BS=1
SAVE_STRATEGY=no
SAVE_TOTAL_LIMIT=1
